# Copy this file to .env and fill in real values. Never commit .env itself.

# Random long string used to sign login sessions — generate one with:
# openssl rand -hex 32
JWT_SECRET=replace-with-a-long-random-string

# Gmail SMTP (use an App Password, not your real Gmail password):
# https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-gmail-address@gmail.com
SMTP_PASS=your-16-character-app-password
SMTP_FROM=your-gmail-address@gmail.com

# Comma-separated emails to grant admin access to (manage accounts, reset passwords,
# add/remove tools on anyone's behalf). Applied on container startup — restart after changing.
ADMIN_EMAILS=your-email@gmail.com
